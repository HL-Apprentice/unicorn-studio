# ~/.config/unicorn/config.env   (chmod 600; never commit)
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USER=unicorn
MQTT_PASSWORD=change-me
# 6 hex digits from the board's topic unicorn/<id>  (run: unicorn boards)
UNICORN_ID=
# optional
# MQTT_TLS=1
# OTA_KEY=same-value-as-on-the-board
# UNICORN_USB=/dev/cu.usbmodemXXXX
# SECRETS_FILE=~/path/to/another/file.env
