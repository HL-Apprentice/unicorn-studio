# Optional: ~/Library/Application Support/Unicorn Studio/config.env  (chmod 600; never commit)
# You can instead type these into the app's Settings; the password then lives in the macOS Keychain.
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USER=unicorn
MQTT_PASSWORD=change-me
# the board's topic base: unicorn/ + last 6 hex digits of its MAC (the app can also discover boards)
UNICORN_BASE=unicorn/abc123
# MQTT_TLS=1
