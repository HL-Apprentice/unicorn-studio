# Unicorn Studio (Linux) connection settings. Copy to ~/.config/unicorn-studio/config.env and chmod 600.
# The CLI's ~/.config/unicorn/config.env is read too, so one file can serve both.
# Environment variables with the same names override this file.
MQTT_BROKER=homeassistant.local
MQTT_PORT=1883
MQTT_USER=unicorn
MQTT_PASSWORD=change-me
# MQTT_TLS=1
# Board id from the board's MQTT topics (unicorn/<id>); leave empty to use the first board found.
UNICORN_ID=abc123
# UNICORN_LIBRARY=$HOME/Documents/Unicorn Displays
# Or keep the secrets elsewhere and point at them (followed up to 3 files deep):
# SECRETS_FILE=$HOME/.config/unicorn/secrets.env
